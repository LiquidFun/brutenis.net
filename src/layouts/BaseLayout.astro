---
import "@styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  /** Drops the max-w-5xl reading column so content spans the viewport (/photography). */
  fullWidth?: boolean;
}

const { title, description = "Brutenis's personal website - a yarn-tangled corner of the internet", noindex = false, fullWidth = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />

<title>{title} | brutenis.net</title>
    <ClientRouter />
  </head>
  <body class="flex flex-col min-h-screen">
    <!-- Game canvas (behind content) -->
    <canvas id="yarn-game-canvas" class="yarn-canvas yarn-canvas-game" transition:persist="yarn-game-canvas"></canvas>
    <!-- Cursor canvas (above content) -->
    <canvas id="yarn-cursor-canvas" class="yarn-canvas yarn-canvas-cursor" transition:persist="yarn-cursor-canvas"></canvas>
    <!--
      Theme toggle, pinned to the top-left corner as the mirror of the game HUD
      on the right. A direct child of <body> rather than a nav item for the same
      reason the HUD is: it is position:fixed, so inside the nav it would be
      positioned against the viewport anyway while still taking part in the
      row's layout and pushing the logo around.

      Not transition:persist — it holds no script state. The click handler is
      delegated off document (see @scripts/theme-toggle) so it survives the body
      being swapped, and the sun/moon state is pure CSS off html.dark.
    -->
    <button
      id="theme-toggle"
      type="button"
      class="theme-toggle"
      aria-label="Switch colour theme"
      aria-pressed="false"
      title="Toggle dark mode"
    >
      <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4.4" />
        <g stroke-linecap="round">
          <path d="M12 2.6v2.4M12 19v2.4M2.6 12h2.4M19 12h2.4" />
          <path d="M5.4 5.4 7.1 7.1M16.9 16.9l1.7 1.7M18.6 5.4 16.9 7.1M7.1 16.9l-1.7 1.7" />
        </g>
      </svg>
      <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20 14.2A8.4 8.4 0 0 1 9.8 4a8.4 8.4 0 1 0 10.2 10.2z" />
      </svg>
    </button>
    <!--
      Game HUD + attackers toggle. It stays a direct child of <body>: it is
      transition:persist, and a persisted element inside <nav> would be moved
      into each incoming nav on every client-side navigation, which restarts its
      CSS transitions and makes the whole row flicker. On desktop it is pinned to
      the right of the nav bar, on touch devices it keeps its old bottom-centre
      placement.
    -->
    <div id="game-hud" class="game-hud" title="Start Game" transition:persist="game-hud">
      <span class="hud-sword">&#x2694;</span>
      <span class="font-heading text-lg hud-play-label">Play</span>
      <span class="hud-sword hud-sword-end">&#x2694;</span>
      <span id="hud-disable-label" class="font-heading text-lg hud-label">Disable Game</span>
      <span id="hud-separator" class="hud-separator start-hidden">|</span>
      <span id="game-score-wrap" class="font-heading text-lg hud-score start-hidden">Defended: <span id="game-score">0</span></span>
      <span class="hud-dismiss">&times;</span>
    </div>
    <!-- Game over overlay -->
    <div id="game-over-overlay" class="game-over-overlay start-hidden" transition:persist="game-over-overlay">
      <div class="game-over-box">
        <h2 class="font-heading text-6xl font-bold text-yarn-coral mb-2">Game Over!</h2>
        <p class="font-heading text-2xl text-text-charcoal mb-1">Defended <span id="game-over-score">0</span> attacks</p>
        <p class="font-heading text-xl text-text-muted">Reached Level <span id="game-over-level">1</span></p>
        <div id="score-submit-section" class="score-submit-section">
          <input id="score-name-input" type="text" placeholder="Your name" maxlength="20" class="score-name-input" />
          <button id="submit-score-btn" class="submit-score-btn">Submit to Leaderboard</button>
          <p id="submit-rank" class="submit-rank start-hidden"></p>
        </div>
        <button id="try-again-btn" class="try-again-btn">Try Again</button>
        <button id="disable-attackers-btn" class="disable-attackers-btn">Disable Attackers</button>
      </div>
    </div>
    <!-- Gyro permission overlay (iOS mobile only) -->
    <div id="gyro-permission-overlay" class="game-over-overlay start-hidden" transition:persist="gyro-permission-overlay">
      <div class="gyro-permission-box">
        <p class="font-heading text-2xl text-text-charcoal mb-3">Tilt to play!</p>
        <p class="font-body text-text-muted mb-4">
          Tilt your phone to bounce the yarn ball and defend your blog posts from monsters.
        </p>
        <button id="gyro-grant-btn" class="try-again-btn">Enable Gyroscope</button>
        <button id="gyro-skip-btn" class="disable-attackers-btn">No thanks</button>
      </div>
    </div>

    <!--
      position:fixed, not sticky. Sticky is only pinned while no ancestor is a
      scroll container, and `overflow-x` on <html> or <body> silently makes one
      in some browsers — the bar then scrolls with the page. Fixed is anchored to
      the viewport regardless, so it cannot regress that way.

      Because it is out of flow it reserves no space: @scripts/fixed-nav keeps
      body's padding-top equal to its measured height, which changes whenever the
      links wrap onto another row.

      Opaque, not bg-bg-cream/90 + backdrop-blur: at 90% the content scrolling
      behind showed through, which also read as the bar moving. Most visible on
      /photography, where a full-bleed photo tinted the whole bar.
    -->
    <nav class="fixed top-0 inset-x-0 z-50 bg-bg-cream border-b-2 border-dashed border-yarn-coral/30">
      <div class="max-w-5xl mx-auto px-4 py-1 flex flex-col items-center sm:flex-row sm:items-center sm:justify-between gap-0 sm:gap-0 sm:py-3">
        <a href="/" class="logo-link" id="animated-logo" transition:persist="animated-logo">
          brutenis.net
        </a>
        <div class="nav-links flex gap-0 sm:gap-1 items-center flex-wrap justify-center sm:justify-start">
          {/*
            No Blog, CTF or Leaderboard tab. The home page *is* the blog listing,
            so the logo already leads there; the writeups are reachable as a
            single entry in that listing, and the leaderboard belongs to the yarn
            easter-egg rather than to the site's contents — it is linked from the
            game-over overlay, the footer and the About page. `extra` lists the
            extra paths a tab should light up for.
          */}
          {[
            { href: "/projects", label: "Projects", extra: [] },
            { href: "/games", label: "Games", extra: [] },
            { href: "/photography", label: "Photography", extra: [] },
            { href: "/about", label: "About", extra: ["/leaderboard"] },
          ].map(({ href, label, extra }) => (
            <a href={href} class:list={["nav-link", { "nav-link-active": Astro.url.pathname.startsWith(href) || extra.some((p) => p === "/" ? Astro.url.pathname === "/" : Astro.url.pathname.startsWith(p)) }]}>{label}</a>
          ))}
        </div>
      </div>
    </nav>

    <main class:list={["flex-1 w-full mx-auto", fullWidth ? "px-2 sm:px-3 py-4" : "max-w-5xl px-4 py-8"]}>
      <slot />
    </main>

    <footer class="border-t-2 border-dashed border-yarn-teal/30 mt-auto">
      <div class="max-w-5xl mx-auto px-4 py-6 text-center text-text-muted text-sm">
        <p class="font-heading text-lg">&copy; {new Date().getFullYear()} brutenis.net</p>
        <div class="flex justify-center gap-4 mt-2">
          <a href="https://github.com/LiquidFun" class="hover:text-yarn-coral transition-colors">GitHub</a>
          <a href="/leaderboard" class="hover:text-yarn-coral transition-colors">Leaderboard</a>
          <a href="/rss.xml" class="hover:text-yarn-coral transition-colors">RSS</a>
        </div>
        <p class="mt-3 text-xs text-text-muted/50 font-heading">Use the yarn ball to defend the blog entries</p>
      </div>
    </footer>

    <script>
      import "@scripts/yarn-cursor/index";
      import "@scripts/yarn-game/index";
      import "@scripts/animated-logo";
      import "@scripts/clickable-cards";
      import "@scripts/theme-toggle";
      import { initFixedNav, teardownFixedNav } from "@scripts/fixed-nav";

      initFixedNav();
      document.addEventListener("astro:page-load", initFixedNav);
      document.addEventListener("astro:before-swap", teardownFixedNav);
    </script>
  </body>
</html>

<style>
  /* Slides away while reading down the page and comes back on the way up;
     @scripts/fixed-nav owns the class. The body's padding is untouched, so
     nothing reflows — only the bar itself moves. */
  nav {
    transition: transform 0.3s ease;
  }

  html.nav-collapsed nav {
    transform: translateY(-100%);
  }

  .nav-link {
    padding: 0.375rem 0.75rem;
    border-radius: 0.5rem;
    font-family: var(--font-heading);
    font-size: 1.25rem;
    color: var(--color-text-charcoal);
    transition: all 0.2s;
  }
  .nav-link:hover {
    background-color: var(--color-bg-warm);
    color: var(--color-yarn-coral);
  }
  .nav-link-active {
    color: var(--color-yarn-coral);
    background-color: var(--color-bg-warm);
  }

  /* Pinned to the top-left corner, tracking .game-hud-collapsed's offsets and
     size on the right at each breakpoint so the two corners read as a pair.
     Frosted like the HUD rather than transparent: it floats over the page
     content once the nav scrolls away, so it needs its own backdrop.

     Sun in light mode, moon in dark — the current state, not the target one,
     matching the aria-pressed the script keeps in sync. Both icons are stacked
     in the same grid cell so the button never changes size as they swap. */
  .theme-toggle {
    position: fixed;
    top: 0.5rem;
    left: 0.5rem;
    /* Same layer as the game HUD: above the nav (50) and above both canvases
       (60/61), or the yarn ball would be drawn over the button. */
    z-index: 100;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 2px dashed var(--color-yarn-teal);
    border-radius: 50%;
    background: var(--surface-frosted);
    backdrop-filter: blur(4px);
    color: var(--color-yarn-teal);
    cursor: pointer;
    box-shadow: 0 1px 6px rgba(78, 205, 196, 0.25);
    transition: transform 0.3s ease, color 0.2s, border-color 0.2s,
                background-color 0.2s;
  }
  .theme-toggle:hover {
    border-style: solid;
    color: var(--color-yarn-coral);
    border-color: var(--color-yarn-coral);
  }

  /* From here up the nav is a row with the logo at its left edge, so the button
     is no longer floating in empty space beside a centred logo — the logo has
     to be pushed clear of it. The button spans from ~0.55rem to ~3.55rem off
     the left edge; the logo starts one px-4 inside the centred 64rem column, so
     it only needs pushing once that gutter is too thin to hold the button
     beside it. Wide windows get 0 and the logo does not move from where it has
     always been. Mirror of the .nav-links reserve for the game HUD below. */
  @media (min-width: 640px) {
    .theme-toggle {
      top: 0.55rem;
      left: 0.55rem;
      width: 3rem;
      height: 3rem;
    }

    .logo-link {
      margin-left: max(0px, calc(3.2rem - max(0px, (100vw - 64rem) / 2)));
    }
  }

  /* Desktop: sized and aligned to the HUD pill's row, and it leaves with the
     nav on scroll for the same reason the pill does — otherwise it is left
     floating over the content on its own. */
  @media (hover: hover) and (pointer: fine) {
    .theme-toggle {
      top: 0.9rem;
      left: 1rem;
      width: 2.55rem;
      height: 2.55rem;
    }

    html.nav-collapsed .theme-toggle {
      transform: translateY(-150%);
    }
  }

  .theme-icon {
    grid-area: 1 / 1;
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .theme-icon-moon {
    opacity: 0;
    transform: rotate(-60deg) scale(0.6);
  }
  html.dark .theme-icon-sun {
    opacity: 0;
    transform: rotate(60deg) scale(0.6);
  }
  html.dark .theme-icon-moon {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-icon {
      transition: none;
    }
  }

  .yarn-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .yarn-canvas-game {
    z-index: 60;
    pointer-events: none;
  }

  .yarn-canvas-cursor {
    z-index: 61;
    pointer-events: none;
  }

  .logo-link {
    font-family: var(--font-heading);
    font-size: 1.875rem;
    font-weight: 700;
    text-decoration: none;
    transition: opacity 0.2s;
    display: inline-block;
    width: 264px;
    height: 53px;
    color: transparent;
  }
  .logo-link:hover {
    opacity: 0.8;
  }

  @media (max-width: 639px) {
    .nav-link {
      font-size: 1rem;
      padding: 0.25rem 0.5rem;
    }
  }

  .hud-sword {
    font-size: 1.1rem;
    line-height: 1;
    color: var(--color-yarn-coral);
  }

  .hud-label {
    color: var(--color-text-muted);
  }

  /* "⚔ Play ⚔" wording: desktop-only, shown in the collapsed (game off) state */
  .hud-play-label,
  .hud-sword-end {
    display: none;
  }

  .hud-separator {
    color: var(--color-text-muted);
    opacity: 0.4;
  }

  .hud-score {
    color: var(--color-text-charcoal);
  }

  .hud-dismiss {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    line-height: 1;
    margin-left: 0.1rem;
    opacity: 0.5;
  }

  .game-hud {
    position: fixed;
    top: calc(100dvh - 5.5rem);
    right: 50%;
    transform: translateX(50%);
    z-index: 100;
    background: var(--surface-frosted);
    backdrop-filter: blur(4px);
    padding: 0.5rem 1.2rem;
    border-radius: 2rem;
    border: 2px solid rgba(255, 107, 107, 0.3);
    box-shadow: 0 2px 16px rgba(255, 107, 107, 0.15), 0 2px 8px rgba(0, 0, 0, 0.08);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
    cursor: pointer;
    user-select: none;
    transition: top 0.5s ease, right 0.5s ease, transform 0.5s ease,
                padding 0.3s ease, border-radius 0.3s ease,
                gap 0.3s ease, background 0.3s ease, box-shadow 0.3s ease;
  }

  @media (min-width: 640px) {
    .game-hud {
      top: calc(100dvh - 12rem);
    }
  }

  .game-hud-collapsed {
    top: 0.5rem;
    right: 0.5rem;
    transform: none;
    padding: 0;
    border-radius: 50%;
    background: var(--color-yarn-coral);
    box-shadow: 0 2px 8px rgba(255, 107, 107, 0.4);
    width: 2.5rem;
    height: 2.5rem;
    justify-content: center;
    gap: 0;
    cursor: pointer;
  }

  .game-hud-collapsed .hud-sword {
    color: white;
    font-size: 1.3rem;
  }

  .game-hud-collapsed .hud-label,
  .game-hud-collapsed .hud-separator,
  .game-hud-collapsed .hud-score,
  .game-hud-collapsed .hud-dismiss {
    display: none;
  }

  @media (min-width: 640px) {
    .game-hud-collapsed {
      width: 3rem;
      height: 3rem;
      top: 0.55rem;
      right: 0.55rem;
    }
    .game-hud-collapsed .hud-sword {
      font-size: 1.6rem;
    }
  }

  /* Desktop: the HUD is a normal item in the nav row (so it can never cover the
     links), and the "game off" state spells out "⚔ Play ⚔" rather than collapsing
     to a sword circle. Both states sit in the same place, so nothing jumps. */
  @media (hover: hover) and (pointer: fine) {
    /* Pinned to the right edge of the window, vertically centred in the nav bar,
       which is sticky at the top, so the two stay aligned while scrolling. */
    .game-hud {
      top: 0.9rem;
      right: 1rem;
      transform: none;
      padding: 0.3rem 0.85rem;
      gap: 0.4rem;
      box-shadow: 0 1px 6px rgba(255, 107, 107, 0.18);
      /* Hold the pill's height when its text is hidden, so it does not twitch as
         the label and score come and go. */
      min-height: 2.55rem;
      /* Matches the nav bar, which the pill rides with below. Shortened from the
         0.5s that the mobile repositioning wants, so the two do not desync. */
      transition-duration: 0.3s;
    }

    /* On desktop the pill sits inside the nav row, so it leaves with it —
       otherwise it is left floating over the photos on its own. */
    html.nav-collapsed .game-hud {
      transform: translateY(-150%);
    }

    /* The button floats over the nav, so the links reserve room for it — but only
       once the window is too narrow for it to fit in the margin beside the 64rem
       content column. On a wide screen the reserve is 0 and the logo and links
       sit exactly where they always have. */
    .nav-links {
      margin-right: max(0px, calc(15.1rem - max(0px, (100vw - 64rem) / 2)));
    }

    .game-hud-collapsed {
      width: auto;
      height: auto;
      padding: 0.3rem 0.85rem;
      border-radius: 2rem;
      gap: 0.4rem;
    }

    .game-hud-collapsed .hud-sword {
      font-size: 1.2rem;
    }

    .game-hud-collapsed .hud-play-label,
    .game-hud-collapsed .hud-sword-end {
      display: inline;
      color: white;
    }
  }

  /* Under ~1150px the nav row cannot fit the logo, the links, the "Disable Game"
     hint and the score at once, and the button would drop onto a second line
     mid-game. Drop the hint (the × and the tooltip still say what a click does)
     and the row survives down to ~1050. !important because the game script sets
     these spans' display inline.

     This threshold tracked the nav's width as tabs were added — out to 1250px
     for "Photos" and 1500px for "Photography" — but dropping the CTF and
     Leaderboard tabs freed more than those cost, so it went back to its
     original 1150px. The theme toggle then took the mirror-image reserve out of
     the left side: below the 64rem column width (~1229px at the 120% root size)
     the logo is pushed a full 3.2rem right, which costs the row ~61px, hence
     1200. */
  @media (hover: hover) and (pointer: fine) and (max-width: 1200px) {
    .game-hud .hud-label,
    .game-hud .hud-separator {
      display: none !important;
    }

    /* Same reserve, sized for the narrower button this rule produces. */
    .nav-links {
      margin-right: max(0px, calc(9.1rem - max(0px, (100vw - 64rem) / 2)));
    }
  }


  .canvas-greyed {
    filter: grayscale(0.8) brightness(0.6);
    transition: filter 0.5s ease;
  }

  .game-over-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(45, 52, 54, 0.5);
    backdrop-filter: blur(3px);
  }
  .game-over-box {
    text-align: center;
    background: var(--color-bg-cream);
    padding: 2.5rem 3rem;
    border-radius: 1rem;
    border: 3px dashed var(--color-yarn-coral);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.2);
  }
  .try-again-btn,
  .disable-attackers-btn {
    margin-top: 0.5rem;
    padding: 0.6rem 2rem;
    border: 2px solid transparent;
    border-radius: 0.75rem;
    font-family: var(--font-heading);
    font-size: 1.4rem;
    cursor: pointer;
    transition: all 0.2s;
    width: 100%;
    box-sizing: border-box;
  }
  .try-again-btn {
    margin-top: 1rem;
    background: var(--color-yarn-coral);
    color: white;
    border-color: var(--color-yarn-coral);
  }
  .try-again-btn:hover {
    background: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
    transform: translateY(-2px);
  }
  .disable-attackers-btn {
    background: transparent;
    color: var(--color-text-muted);
    border-color: var(--color-text-muted);
    border-style: dashed;
  }
  .disable-attackers-btn:hover {
    background: var(--color-text-muted);
    color: white;
    transform: translateY(-2px);
  }

  .score-submit-section {
    margin-top: 1rem;
    margin-bottom: 0.25rem;
  }

  .score-name-input {
    font-family: var(--font-body);
    font-size: 1.1rem;
    padding: 0.5rem 1rem;
    border: 2px dashed var(--color-yarn-teal);
    border-radius: 0.75rem;
    background: var(--color-surface);
    color: var(--color-text-charcoal);
    width: 100%;
    max-width: 240px;
    text-align: center;
    outline: none;
    box-sizing: border-box;
  }

  .score-name-input:focus {
    border-style: solid;
    border-color: var(--color-yarn-teal);
  }

  .submit-score-btn {
    margin-top: 0.5rem;
    padding: 0.6rem 2rem;
    border: 2px solid var(--color-yarn-teal);
    border-radius: 0.75rem;
    font-family: var(--font-heading);
    font-size: 1.4rem;
    cursor: pointer;
    transition: all 0.2s;
    width: 100%;
    box-sizing: border-box;
    background: var(--color-yarn-teal);
    color: white;
  }

  .submit-score-btn:hover {
    opacity: 0.85;
    transform: translateY(-2px);
  }

  .submit-score-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }

  .submit-rank {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    color: var(--color-yarn-coral);
    margin-top: 0.25rem;
    font-weight: 700;
  }

  .submit-rank-link {
    display: inline-block;
    margin-top: 0.25rem;
    font-size: 1.1rem;
    color: var(--color-yarn-teal);
    text-decoration: underline;
    font-weight: 400;
  }

  .submit-rank-link:hover {
    color: var(--color-text-charcoal);
  }

  .gyro-permission-box {
    text-align: center;
    background: var(--color-bg-cream);
    padding: 2rem 2.5rem;
