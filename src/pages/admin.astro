---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout title="Admin" description="Leaderboard administration" noindex={true}>
  <h1 class="text-5xl font-heading font-bold text-yarn-coral mb-2">Admin</h1>
  <p class="font-body text-text-muted mb-6">
    Every submitted run, newest first. Marking a run as cheated hides it from the
    public leaderboard; nothing is deleted.
  </p>

  {/*
    Overview panel. Everything here comes from the sessions table — these are
    *game* numbers. Page views are a separate question, answered by the GoAccess
    report at /admin/stats, which this page deliberately knows nothing about.
  */}
  <section id="admin-stats" class="admin-stats start-hidden" aria-labelledby="stats-heading">
    <h2 id="stats-heading" class="stats-heading">Overview</h2>
    <div class="stat-tiles" id="stat-tiles"></div>

    <figure class="chart-figure">
      <figcaption class="chart-caption">
        <span>Runs submitted per day &middot; last 30 days (UTC)</span>
        <span class="chart-peak" id="chart-peak"></span>
      </figcaption>
      {/*
        aria-hidden, with the <details> table below as the real accessible
        version. Labelling 30 bars individually produces a screen-reader
        experience nobody wants; a table is the thing people actually use.
      */}
      <div class="chart-plot" id="chart-plot" aria-hidden="true"></div>
      <div class="chart-axis">
        <span id="chart-from"></span>
        <span id="chart-to"></span>
      </div>
    </figure>

    <p class="stat-note" id="stat-note"></p>

    <details class="chart-table">
      <summary>Table view</summary>
      <div class="chart-table-wrap">
        <table class="admin-table" id="chart-table"></table>
      </div>
    </details>
  </section>

  <p id="admin-status" class="font-heading text-xl text-text-muted">Loading runs...</p>

  <div id="admin-table-wrap" class="admin-table-wrap start-hidden">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Name</th>
          <th class="num">Score</th>
          <th class="num">Lvl</th>
          <th class="num">Duration</th>
          <th class="num">Events</th>
          <th>Date</th>
          <th>Flags</th>
          <th>State</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="admin-body"></tbody>
    </table>
  </div>
</BaseLayout>

<script>
  interface AdminSession {
    session_id: string;
    name: string;
    score: number;
    level: number;
    duration_s: number;
    date: string;
    version: string;
    platform: string;
    is_valid: boolean;
    notes: string[];
    replay_events: number;
  }

  // The API rejects requests without this. A cross-site form cannot set a
  // header, and a cross-origin fetch that does gets preflighted and refused,
  // so it confines the admin API to calls made from this page.
  const ADMIN_HEADERS = { "X-Admin-Request": "1" };

  function formatDuration(seconds: number): string {
    const m = Math.floor(seconds / 60);
    const s = Math.round(seconds % 60);
    return m > 0 ? `${m}m ${s}s` : `${s}s`;
  }

  /** ISO-style local timestamp without the "T": 2026-08-25 20:55 */
  function formatDate(iso: string): string {
    if (!iso) return "";
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return "";
    const p = (n: number) => String(n).padStart(2, "0");
    return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}`;
  }

  interface ReplayEvent {
    seq: number;
    event_type: string;
    timestamp_ms: number;
    payload?: Record<string, unknown> | null;
  }

  async function fetchReplay(sessionId: string): Promise<ReplayEvent[]> {
    const resp = await fetch(`/admin/api/sessions/${sessionId}/replay`, {
      headers: ADMIN_HEADERS,
    });
    if (!resp.ok) throw new Error(`Replay failed: ${resp.status}`);
    return (await resp.json()).events as ReplayEvent[];
  }

  /** Row inserted under a run to list its replay events; toggled by the Events cell. */
  function buildReplayRow(colSpan: number, events: ReplayEvent[]): HTMLTableRowElement {
    const tr = document.createElement("tr");
    tr.className = "replay-row";
    const td = document.createElement("td");
    td.colSpan = colSpan;

    if (events.length === 0) {
      td.textContent = "No replay stored for this run.";
    } else {
      const list = document.createElement("ol");
      list.className = "replay-list";
      for (const e of events) {
        const li = document.createElement("li");
        const time = document.createElement("span");
        time.className = "replay-time";
        time.textContent = `${(e.timestamp_ms / 1000).toFixed(1)}s`;
        const type = document.createElement("span");
        type.className = "replay-type";
        type.textContent = e.event_type;
        li.append(time, type);
        if (e.payload && Object.keys(e.payload).length > 0) {
          const payload = document.createElement("span");
          payload.className = "replay-payload";
          payload.textContent = Object.entries(e.payload)
            .map(([k, v]) => `${k}=${v}`)
            .join(" ");
          li.appendChild(payload);
        }
        list.appendChild(li);
      }
      td.appendChild(list);
    }

    tr.appendChild(td);
    return tr;
  }

  function setStatus(msg: string) {
    const el = document.getElementById("admin-status");
    if (el) {
      el.textContent = msg;
      el.style.display = msg ? "" : "none";
    }
  }

  async function setValidity(sessionId: string, isValid: boolean, reason: string) {
    const resp = await fetch(`/admin/api/sessions/${sessionId}/validity`, {
      method: "POST",
      headers: { ...ADMIN_HEADERS, "Content-Type": "application/json" },
      body: JSON.stringify({ is_valid: isValid, reason }),
    });
    if (!resp.ok) throw new Error(`Update failed: ${resp.status}`);
    return (await resp.json()) as AdminSession;
  }

  function renderRow(tr: HTMLTableRowElement, s: AdminSession) {
    tr.classList.toggle("row-invalid", !s.is_valid);

    // Drop a stale expanded replay so the toggle arrow stays in sync
    if (tr.nextElementSibling?.classList.contains("replay-row")) {
      tr.nextElementSibling.remove();
    }

    const cells = [
      s.name,
      s.score.toLocaleString(),
      String(s.level),
      formatDuration(s.duration_s),
    ];

    tr.replaceChildren();
    for (const [i, text] of cells.entries()) {
      const td = document.createElement("td");
      if (i >= 1) td.className = "num font-mono";
      td.textContent = text;
      tr.appendChild(td);
    }

    // Events cell: click to expand the stored replay underneath this row
    const eventsCell = document.createElement("td");
    eventsCell.className = "num";
    if (s.replay_events === 0) {
      eventsCell.textContent = "0";
      eventsCell.classList.add("events-empty");
    } else {
      const toggle = document.createElement("button");
      toggle.className = "events-toggle";
      toggle.textContent = `${s.replay_events} \u25BE`;
      toggle.addEventListener("click", async () => {
        const existing = tr.nextElementSibling;
        if (existing?.classList.contains("replay-row")) {
          existing.remove();
          toggle.textContent = `${s.replay_events} \u25BE`;
          return;
        }
        toggle.disabled = true;
        try {
          const events = await fetchReplay(s.session_id);
          tr.after(buildReplayRow(tr.children.length, events));
          toggle.textContent = `${s.replay_events} \u25B4`;
        } catch (e) {
          setStatus(String(e));
        } finally {
          toggle.disabled = false;
        }
      });
      eventsCell.appendChild(toggle);
    }
    tr.appendChild(eventsCell);

    const dateCell = document.createElement("td");
    dateCell.className = "font-mono";
    dateCell.textContent = formatDate(s.date);
    tr.appendChild(dateCell);

    const flags = document.createElement("td");
    flags.className = "flags";
    flags.textContent = s.notes.join(", ");
    flags.title = `${s.session_id} | ${s.version} | ${s.platform}`;
    tr.appendChild(flags);

    const state = document.createElement("td");
    state.className = s.is_valid ? "state-ok" : "state-bad";
    state.textContent = s.is_valid ? "shown" : "hidden";
    tr.appendChild(state);

    const actions = document.createElement("td");
    const btn = document.createElement("button");
    btn.className = s.is_valid ? "admin-btn" : "admin-btn admin-btn-restore";
    btn.textContent = s.is_valid ? "Mark cheated" : "Restore";
    btn.addEventListener("click", async () => {
      const target = !s.is_valid;
      let reason = "";
      if (!target) {
        const input = prompt("Reason (optional):");
        if (input === null) return; // cancelled — leave the run untouched
        reason = input;
      }
      btn.disabled = true;
      try {
        renderRow(tr, await setValidity(s.session_id, target, reason));
      } catch (e) {
        btn.disabled = false;
        setStatus(String(e));
      }
    });
    actions.appendChild(btn);
    tr.appendChild(actions);
  }

  async function loadAdmin() {
    const tbody = document.getElementById("admin-body");
    const wrap = document.getElementById("admin-table-wrap");
    if (!tbody) return;

    try {
      const resp = await fetch("/admin/api/sessions", { headers: ADMIN_HEADERS });
      if (!resp.ok) throw new Error(`Fetch failed: ${resp.status}`);
      const data = (await resp.json()) as { sessions: AdminSession[]; total: number };

      if (data.sessions.length === 0) {
        setStatus("No runs submitted yet.");
        return;
      }

      tbody.replaceChildren();
      for (const s of data.sessions) {
        const tr = document.createElement("tr");
        renderRow(tr, s);
        tbody.appendChild(tr);
      }

      setStatus("");
      // Explicit value, not "": #admin-table-wrap starts hidden via
      // .start-hidden, and "" would clear the inline style and re-hide it.
      if (wrap) wrap.style.display = "block";
    } catch {
      setStatus("Failed to load runs.");
    }
  }

  // ── Overview panel ──

  interface DayCount {
    day: string;
    runs: number;
    players: number;
  }

  interface AdminStats {
    submitted_total: number;
    players_total: number;
    submitted_24h: number;
    submitted_7d: number;
    players_7d: number;
    in_progress: number;
    retention_hours: number;
    mobile_runs: number;
    desktop_runs: number;
    invalid_runs: number;
    best_score: number;
    daily: DayCount[];
  }

  function tile(value: string, label: string): HTMLElement {
    const el = document.createElement("div");
    el.className = "stat-tile";
    const v = document.createElement("span");
    v.className = "stat-value";
    v.textContent = value;
    const l = document.createElement("span");
    l.className = "stat-label";
    l.textContent = label;
    el.append(v, l);
    return el;
  }

  /** "12 Sep", for the axis ends and the table. */
  function shortDay(iso: string): string {
    const d = new Date(`${iso}T00:00:00Z`);
    if (Number.isNaN(d.getTime())) return iso;
    return d.toLocaleDateString("en-GB", { day: "numeric", month: "short", timeZone: "UTC" });
  }

  function renderChart(daily: DayCount[]) {
    const plot = document.getElementById("chart-plot");
    const table = document.getElementById("chart-table");
    if (!plot || !table) return;

    // A flat-zero series would otherwise divide by zero; 1 keeps every bar at
    // the floor instead of making them all full height.
    const peak = Math.max(1, ...daily.map((d) => d.runs));

    plot.replaceChildren();
    for (const d of daily) {
      const bar = document.createElement("div");
      bar.className = "bar";
      // A day with no runs still gets a visible stub, so the gap reads as "no
      // runs" rather than as a rendering failure.
      bar.style.setProperty("--fill", `${d.runs === 0 ? 0 : (d.runs / peak) * 100}%`);
      if (d.runs === peak) bar.classList.add("bar-peak");

      const tip = document.createElement("span");
      tip.className = "bar-tip";
      tip.textContent = `${shortDay(d.day)}: ${d.runs} run${d.runs === 1 ? "" : "s"}, ${d.players} player${d.players === 1 ? "" : "s"}`;
      bar.appendChild(tip);
      // Focusable so the tooltip is reachable without a pointer.
      bar.tabIndex = 0;
      plot.appendChild(bar);
    }

    const peakEl = document.getElementById("chart-peak");
    if (peakEl) peakEl.textContent = `peak ${peak}/day`;
    const from = document.getElementById("chart-from");
    const to = document.getElementById("chart-to");
    if (from && daily.length) from.textContent = shortDay(daily[0].day);
    if (to && daily.length) to.textContent = shortDay(daily[daily.length - 1].day);

    const head = document.createElement("tr");
    for (const label of ["Day", "Runs", "Players"]) {
      const th = document.createElement("th");
      th.textContent = label;
      head.appendChild(th);
    }
    const body = document.createElement("tbody");
    for (const d of daily) {
      const tr = document.createElement("tr");
      for (const [i, text] of [shortDay(d.day), String(d.runs), String(d.players)].entries()) {
        const td = document.createElement("td");
        if (i > 0) td.className = "num font-mono";
        td.textContent = text;
        tr.appendChild(td);
      }
      body.appendChild(tr);
    }
    const thead = document.createElement("thead");
    thead.appendChild(head);
    table.replaceChildren(thead, body);
  }

  async function loadStats() {
    const section = document.getElementById("admin-stats");
    const tiles = document.getElementById("stat-tiles");
    if (!section || !tiles) return;

    try {
      const resp = await fetch("/admin/api/stats", { headers: ADMIN_HEADERS });
      if (!resp.ok) throw new Error(String(resp.status));
      const s = (await resp.json()) as AdminStats;

      const platformRuns = s.mobile_runs + s.desktop_runs;
      const mobilePct = platformRuns === 0 ? 0 : Math.round((s.mobile_runs / platformRuns) * 100);

      tiles.replaceChildren(
        tile(s.players_total.toLocaleString(), "players, all time"),
        tile(s.submitted_total.toLocaleString(), "runs submitted"),
        tile(s.players_7d.toLocaleString(), "players, 7 days"),
        tile(s.submitted_7d.toLocaleString(), "runs, 7 days"),
        tile(s.best_score.toLocaleString(), "best score"),
        tile(`${mobilePct}%`, "played on mobile"),
      );

      renderChart(s.daily);

      const note = document.getElementById("stat-note");
      if (note) {
        // The retention caveat is the whole reason this sentence exists: an
        // unfinished session is deleted after a couple of hours, so this figure
        // is a snapshot of right now and not comparable to the others.
        note.textContent =
          `${s.in_progress} game${s.in_progress === 1 ? "" : "s"} in progress ` +
          `(started within the last ${s.retention_hours}h and not yet submitted — ` +
          `older unfinished sessions are deleted, so this is not a running total). ` +
          `${s.invalid_runs} submitted run${s.invalid_runs === 1 ? " is" : "s are"} ` +
          `flagged invalid and hidden from the leaderboard; they are counted above.`;
      }

      section.style.display = "block";
    } catch {
      // The runs table is the page's real job — a broken overview must not
      // stop it rendering, so this fails quietly and leaves the section hidden.
    }
  }

  document.addEventListener("astro:page-load", () => {
    loadAdmin();
    loadStats();
  });
</script>

<!-- is:global is required: the rows are built at runtime by the script above, so
     they never receive Astro's scoping attribute and scoped rules would not match
     them. Every selector is therefore rooted at .admin-table* to avoid leaking. -->
<style is:global>
  /* ── Overview panel ──
     The bar colour is NOT --color-yarn-teal. That one is a decorative accent
     picked to sit on the cream paper; as a data mark it lands at 1.88:1 against
     the light surface, which is a stripe you cannot read. These two are the
     nearest steps in the same hue that clear both the lightness band and 3:1
     contrast against each theme's own surface, checked rather than eyeballed.
     Dark is its own step, not a flip of the light one. */
  .admin-stats {
    --chart-mark: #0f9c8f;
    margin-bottom: 2.5rem;
  }

  html.dark .admin-stats {
    --chart-mark: #1aa79c;
  }

  .stats-heading {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-text-charcoal);
    margin-bottom: 0.75rem;
  }

  .stat-tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .stat-tile {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.75rem 0.9rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border-soft);
    border-radius: 0.6rem;
  }

  /* Text tokens, never the mark colour: the number is the value, not a series. */
  .stat-value {
    font-family: var(--font-heading);
    font-size: 1.9rem;
    font-weight: 700;
    line-height: 1.1;
    color: var(--color-text-charcoal);
  }

  .stat-label {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .chart-figure {
    margin: 0 0 0.75rem;
  }

  .chart-caption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 0.4rem;
  }

  .chart-peak {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .chart-plot {
    display: flex;
    align-items: flex-end;
    /* 2px between adjacent bars, so neighbouring days never fuse into one mark. */
    gap: 2px;
    height: 7rem;
    /* Recessive: a hairline baseline, no grid. The numbers are in the tiles and
       the tooltip; the chart's job is the shape. */
    border-bottom: 1px solid var(--color-border-soft);
    padding-bottom: 1px;
  }

  .bar {
    position: relative;
    flex: 1;
    min-width: 0;
    /* The track is transparent; only --fill is painted. A zero day therefore
       shows the 2px floor below rather than a full-height pale bar. */
    height: 100%;
    display: flex;
    align-items: flex-end;
  }

  .bar::after {
    content: "";
    display: block;
    width: 100%;
    height: max(var(--fill), 2px);
    background: var(--chart-mark);
    /* Rounded data-end, square against the baseline it is anchored to. */
    border-radius: 3px 3px 0 0;
  }

  .bar-peak::after {
    /* Secondary encoding for the tallest day, so "which was the best day" does
       not rest on comparing two similar heights by eye. */
    outline: 2px solid var(--color-text-muted);
    outline-offset: 1px;
  }

  .bar:hover::after,
  .bar:focus-visible::after {
    filter: brightness(1.15);
  }

  .bar:focus-visible {
    outline: none;
  }

  .bar-tip {
    position: absolute;
    bottom: calc(100% + 0.4rem);
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    display: none;
    white-space: nowrap;
    font-family: var(--font-body);
    font-size: 0.8rem;
    padding: 0.25rem 0.5rem;
    border-radius: 0.35rem;
    background: var(--color-text-charcoal);
    color: var(--color-bg-cream);
    pointer-events: none;
  }

  .bar:hover .bar-tip,
  .bar:focus-visible .bar-tip {
    display: block;
  }

  .chart-axis {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-muted);
    margin-top: 0.3rem;
  }

  .stat-note {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }

  .chart-table > summary {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .chart-table-wrap {
    max-height: 18rem;
    overflow-y: auto;
    margin-top: 0.5rem;
  }

  .admin-table-wrap {
    overflow-x: auto;
  }

  .admin-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-body);
    font-size: 0.9rem;
  }

  .admin-table th,
  .admin-table td {
    text-align: center;
    vertical-align: middle;
  }

  .admin-table th {
    font-family: var(--font-heading);
    font-size: 1rem;
    padding: 0.5rem 0.6rem;
    border-bottom: 2px dashed var(--color-yarn-coral);
    color: var(--color-text-charcoal);
    white-space: nowrap;
  }

  .admin-table td {
    padding: 0.45rem 0.6rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    white-space: nowrap;
  }

  .admin-table .flags {
    white-space: normal;
    max-width: 20rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .admin-table .row-invalid {
    opacity: 0.55;
    background: rgba(255, 107, 107, 0.06);
  }

  .admin-table .state-ok {
    color: var(--color-yarn-teal);
  }

  .admin-table .state-bad {
    color: var(--color-yarn-coral);
  }

  .admin-table .events-empty {
    color: var(--color-text-muted);
  }

  .admin-table .events-toggle {
    font-family: var(--font-mono, monospace);
    font-size: 0.9rem;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--color-yarn-teal);
    border-radius: 0.4rem;
    background: transparent;
    color: var(--color-yarn-teal);
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .admin-table .events-toggle:hover:not(:disabled) {
    background: var(--color-yarn-teal);
    color: white;
  }

  .admin-table .events-toggle:disabled {
    opacity: 0.5;
    cursor: wait;
  }

  .admin-table .replay-row > td {
    text-align: left;
    white-space: normal;
    background: rgba(0, 0, 0, 0.03);
    padding: 0.6rem 1rem;
  }

  .admin-table .replay-list {
    margin: 0;
    padding-left: 1.5rem;
    max-height: 20rem;
    overflow-y: auto;
    font-family: var(--font-mono, monospace);
    font-size: 0.8rem;
    line-height: 1.6;
    list-style: decimal;
    color: var(--color-text-charcoal);
  }

  .admin-table .replay-time {
    display: inline-block;
    min-width: 4rem;
    color: var(--color-text-muted);
  }

  .admin-table .replay-type {
    display: inline-block;
    min-width: 10rem;
    font-weight: 700;
  }

  .admin-table .replay-payload {
    color: var(--color-text-muted);
  }

  .admin-table .admin-btn {
    font-family: var(--font-heading);
    font-size: 1rem;
    line-height: 1;
    padding: 0.5rem 1.1rem;
    border: none;
    border-radius: 0.6rem;
    background: var(--color-yarn-coral);
    color: white;
    cursor: pointer;
    white-space: nowrap;
    box-shadow: 0 2px 0 rgba(0, 0, 0, 0.18);
    transition: transform 0.12s ease, box-shadow 0.12s ease, background 0.2s ease;
  }

  .admin-table .admin-btn:hover:not(:disabled) {
    background: var(--color-accent-hover);
    transform: translateY(-1px);
    box-shadow: 0 3px 0 rgba(0, 0, 0, 0.18);
  }

