---
import { getTagColorClass } from "@lib/tag-colors";

interface Props {
  tag: string;
  active?: boolean;
}

const { tag, active = false } = Astro.props;

const colorClass = getTagColorClass(tag);
---

<a
  href={`/blog/tag/${tag}`}
  class:list={["tag-pill", colorClass, { active }]}
>
  {tag}
</a>

<style>
  .tag-pill {
    display: inline-block;
    padding: 0.15rem 0.6rem;
    border: 2px dashed var(--yarn-color);
    border-radius: 9999px;
    font-family: var(--font-heading);
    font-size: 0.95rem;
    color: var(--yarn-color);
    transition: all 0.2s;
    text-decoration: none;
  }
  .tag-pill:hover,
  .tag-pill.active {
    background-color: var(--yarn-color);
    color: white;
  }
</style>
